{
  "name": "aikayun-license-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "migrate": "node dist/db/migrate-cli.js",
    "migrate:dev": "tsx src/db/migrate-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "admin": "tsx src/admin/cli.ts",
    "keygen": "tsx src/crypto/keygen.ts",
    "trust-bundle:offline": "tsx tools/offline-trust/sign.ts"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@misskey-dev/node-http-message-signatures": "1.1.2",
    "canonicalize": "5.1.0",
    "fastify": "5.12.7",
    "jose": "6.2.13",
    "jsonc-parser": "3.3.1",
    "kysely": "0.29.7",
    "pg": "8.23.1",
    "structured-headers": "1.0.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
